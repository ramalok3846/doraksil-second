{
  "_설명": "기존 Firebase 규칙의 \"rules\" 안에 \"dr\" 블록만 추가해서 게시하세요 (홈페이지 리포의 database.rules.all.json 에는 이미 합쳐 두었어요).",
  "rules": {
    "dr": {
      "cfg": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['books','ts'])"
      },
      "records": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$id": {
          ".write": "(!data.exists() && newData.exists()) || auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['json','ts']) && newData.child('json').isString() && newData.child('json').val().length < 60000"
        }
      },
      "board": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$id": {
          ".write": "(!data.exists() && newData.exists()) || auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['n','t','ts']) && newData.child('n').isNumber() && newData.child('t').isNumber()"
        }
      },
      "cnt": {
        ".read": true,
        ".write": "(newData.isNumber() && (!data.exists() || newData.val() > data.val())) || auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "live": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$dev": {
          ".write": "true",
          ".validate": "newData.hasChildren(['st','ts']) && newData.child('st').isString() && newData.child('st').val().length < 3000 && newData.child('ts').isNumber()"
        }
      },
      "cmd": {
        "$dev": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['id','type','ts'])"
        }
      }
    }
  }
}