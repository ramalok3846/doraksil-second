{
  "cleanUrls": false,
  "headers": [
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}, {"key": "Service-Worker-Allowed", "value": "/"}]},
    {"source": "/version.json", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
    {"source": "/(index.html)?", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
    ]}
  ]
}
